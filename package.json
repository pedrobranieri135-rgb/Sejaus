{
  "name": "seja-us-store",
  "version": "1.0.0",
  "private": true,
  "description": "Loja virtual Seja US — US Adapt & US Essential",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "seed": "node --env-file-if-exists=.env server/seed.js --reset",
    "demo": "node --env-file-if-exists=.env server/demo.js",
    "test": "node --env-file-if-exists=.env --test tests/*.test.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  }
}
