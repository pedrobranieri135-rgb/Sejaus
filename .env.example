# Copie para .env e ajuste
PORT=3000
NODE_ENV=development
# Primeiro usuário do painel /admin (criado na 1ª execução; depois troque a senha pelo painel)
ADMIN_EMAIL=admin@sejaus.com.br
ADMIN_PASSWORD=troque-esta-senha
# Opcional: token para integrações via API (Authorization: Bearer ...)
ADMIN_TOKEN=
# WhatsApp da loja, só números com DDI+DDD (ex.: 5511999999999)
WHATSAPP_NUMBER=5500000000000
# Chave Pix que recebe os pagamentos
PIX_KEY=pix@sejaus.com.br
PIX_MERCHANT_NAME=SEJA US
PIX_MERCHANT_CITY=SAO PAULO
# Frete grátis a partir de (centavos) e prazo para pagar o pedido (horas)
FREE_SHIPPING_CENTS=29900
ORDER_TTL_HOURS=48
# Atrás de proxy/CDN (Render, Railway, Nginx): 1
# Na Vercel: 1
TRUST_PROXY=0

# --- Supabase ---
# Local: conexão direta ou Session pooler (porta 5432).
# Vercel: Transaction pooler (porta 6543) com o usuário da loja:
#   postgresql://loja_app.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres
# Caracteres especiais da senha precisam ser codificados (ex.: @ vira %40).
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
DB_SCHEMA=loja
# Opcional: certificado do projeto (Database → SSL) para verificar a conexão de ponta a ponta
DATABASE_CA_CERT=
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Project Settings → API Keys → Secret key (sb_secret_...). Nunca coloque no front-end.
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=produtos
# Vercel: segredo do cron que expira pedidos não pagos (texto longo e aleatório)
CRON_SECRET=
